				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Shows a dialog: title, message, buttons (comma-separated). Prints the button pressed.
dialog() {
    osascript -e 'on run argv' \
        -e 'set AppleScript'"'"'s text item delimiters to ","' \
        -e 'set btns to text items of (item 3 of argv)' \
        -e 'set r to display alert (item 1 of argv) message (item 2 of argv) buttons btns default button (count of btns)' \
        -e 'return button returned of r' \
        -e 'end run' "$1" "$2" "$3"
}

TOOL="/Users/PvUtrix_1/Apps/_Tools/telegram_chat_analyzer"
cd "$TOOL" || { dialog "Clean Telegram Chat failed" "Tool folder not found: $TOOL" "OK"; exit 0; }

BIN="venv/bin/tg-analyzer"
if [ ! -x "$BIN" ]; then
    dialog "Clean Telegram Chat failed" "The analyzer's virtual environment is missing ($BIN). Rebuild it with Python 3.12 and install requirements.txt." "OK"
    exit 0
fi

LOG=/tmp/tg_clean_log.txt

# Runs the cleaner on $1, writing to $2, answering the split question with $3 (y or n).
run_clean() {
    printf '%s\n' "$3" | "$BIN" clean "$1" --approach privacy --level 2 --format text --output "$2" &gt; "$LOG" 2&gt;&amp;1
}

for file in "$@"; do
    OUT_DIR="$(dirname "$file")"
    BASE_NAME="$(basename "$file" .json)"
    OUT_FILE="${OUT_DIR}/${BASE_NAME}_cleaned.txt"

    # First pass keeps one file; the tool renames the export, so remember its new path.
    run_clean "$file" "$OUT_FILE" n
    STATUS=$?
    RENAMED=$(sed -n 's/^.*Parsed [0-9]* messages from //p' "$LOG" | head -1)
    [ -n "$RENAMED" ] &amp;&amp; [ -f "$RENAMED" ] || RENAMED="$file"
    RESULT_MSG="Saved to:
$OUT_FILE"

    if [ $STATUS -eq 0 ] &amp;&amp; grep -q "File size warning" "$LOG"; then
        SIZE=$(sed -n 's/^.*Output file would be \([0-9.]* MB\).*$/\1/p' "$LOG" | head -1)
        CHOICE=$(dialog "Cleaned chat is large" "The cleaned text is ${SIZE:-over 1 MB}, over the 1 MB limit.

Split it into 1 MB parts, or keep one file?" "Keep One File,Split into Parts")
        if [ "$CHOICE" = "Split into Parts" ]; then
            run_clean "$RENAMED" "$OUT_FILE" y
            STATUS=$?
            PARTS=$(ls "${OUT_DIR}/${BASE_NAME}_cleaned_part"*.txt 2&gt;/dev/null | wc -l | tr -d ' ')
            if [ $STATUS -eq 0 ] &amp;&amp; [ "$PARTS" -gt 0 ]; then
                rm -f "$OUT_FILE"
                OUT_FILE=$(ls "${OUT_DIR}/${BASE_NAME}_cleaned_part"*.txt | head -1)
                RESULT_MSG="Split into $PARTS parts in:
$OUT_DIR"
            else
                STATUS=1
            fi
        fi
    fi

    if [ $STATUS -eq 0 ] &amp;&amp; [ -s "$OUT_FILE" ]; then
        BTN=$(dialog "Chat cleaned" "$RESULT_MSG" "Show in Finder,OK")
        [ "$BTN" = "Show in Finder" ] &amp;&amp; open -R "$OUT_FILE"
    else
        DETAILS=$(grep -v -E "FutureWarning|generativeai|google\.genai|See README|warnings\.warn|^[[:space:]]*$" "$LOG" | tail -6)
        BTN=$(dialog "Clean Telegram Chat failed" "$(basename "$file") (exit code $STATUS)

$DETAILS

Full log: $LOG" "Open Log,OK")
        [ "$BTN" = "Open Log" ] &amp;&amp; open -e "$LOG"
    fi
done

exit 0</string>
